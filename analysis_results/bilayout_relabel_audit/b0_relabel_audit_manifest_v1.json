    "readme": "analysis_results/bilayout_relabel_audit/b0_relabel_audit_readme_v1.md"
  },
  "manual_audit_template_schema": [
    "task_id",
    "image_id",
    "scene_id",
    "source_group",
    "hohonet_corner_count",
    "bilayout_corner_count",
    "hohonet_crossdoor_score",
    "bilayout_crossdoor_score",
    "overextend_reduced",
    "overparse_reduced",
    "bilayout_undercoverage",
    "bilayout_new_error",
    "both_wrong",
    "oos_suspect",
    "open_boundary_ambiguity",
    "expert_verdict",
    "usable_for_B1",
    "audit_notes"
  ],
  "allowed_source_group_values": [
    "hard_prediction_failure",
    "highest_g_score",
    "nominal_prediction_structure",
    "soft_prediction_complexity"
  ],
  "allowed_expert_verdict_values": [
    "accept_bilayout_enclosed",
    "accept_with_minor_fix",
    "reject_undercoverage",
    "reject_ambiguous_or_oos",
    "reject_model_error_needs_manual_fix"
  ],
  "expert_verdict_definitions": {
    "accept_bilayout_enclosed": "Current Bi relabel is directly acceptable as enclosed target.",
    "accept_with_minor_fix": "Only tiny local fix is needed; no medium redraw and no room-scope change.",
    "reject_undercoverage": "Bi is too conservative and misses camera-room content.",
    "reject_ambiguous_or_oos": "Boundary/OOS ambiguity prevents clean enclosed target use.",
    "reject_model_error_needs_manual_fix": "The image appears to have a clear enclosed GT, but the current HoHoNet/Bi-Layout candidate requires moderate or larger manual correction before it can be used as an enclosed target. It is a manual relabel candidate, not a clean B1 target."
  },
  "usable_for_B1_rule": {
    "allowed_true_verdicts": [
      "accept_bilayout_enclosed",
      "accept_with_minor_fix"
    ],
    "required_false_conditions": [
      "reject_undercoverage",
      "reject_ambiguous_or_oos",
      "reject_model_error_needs_manual_fix",
      "both_wrong=true",
      "unresolved oos_suspect=true"
    ],
    "notes": "accept_with_minor_fix is usable only when the fix is genuinely minor."
  },
  "optional_future_manual_relabel_tracking_fields": [
    "manual_relabel_candidate",
    "corrected_target_ref",
    "usable_after_manual_relabel"
  ],
  "audit_rules": {
    "no_automatic_visual_judgment": true,
    "manual_review_required": true,
    "deduplicate_before_group_statistics": [
      "task_id",
      "image_id",
      "scene_id"
    ],
    "bi_layout_relabel_not_automatically_correct": true,
    "bi_layout_cue_not_oos_classifier": true,
    "undercoverage_and_new_errors_must_be_reported": true
  },
  "forbidden_uses": [
    "Do not train models from these templates directly.",
    "Do not use B0 outputs to modify A-line P1/C1/C2/T1/V1.",
    "Do not merge Bi-Layout cue into formal A-line g_t.",
    "Do not modify A-line d_t, routing, admission, w_max, tau_d, Score, worker tier, k0/kmax, or stop rules.",
    "Do not treat any cue or audit field as an automatic OOS classifier.",
    "Do not replace GT automatically with Bi-Layout relabels."
  ]
}
