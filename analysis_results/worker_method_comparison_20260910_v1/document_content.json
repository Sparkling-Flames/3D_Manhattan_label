            ],
            [
              "Semi修改＋质量",
              "区分修改倾向及最终参考偏差，行为含义直观。",
              "受初始化类型影响；两者并非独立的能力维度。"
            ],
            [
              "Semi时间＋质量",
              "描述耗时与结果偏差的联合表现。",
              "可能弱化修改策略；不能由此判断投入或效率因果。"
            ],
            [
              "Semi修改＋时间＋质量",
              "同时呈现三个可观察维度，可发现保留预标注倾向。",
              "完整数据覆盖下降；增加维度未带来所有目标一致改善。"
            ],
            [
              "Manual粗类＋Semi细类",
              "分开描述无辅助表现与有辅助修改行为。",
              "分层后人数更少；已有结果为旧版探索，尚未按最新版完整复验。"
            ],
            [
              "空间范围偏好",
              "可能描述人员对边界或范围的系统性选择。",
              "尚无可并列的已验证人员分型；模型输出头不等于人员类别。"
            ]
          ]
