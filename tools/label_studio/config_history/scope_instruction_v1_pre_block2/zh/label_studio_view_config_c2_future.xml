<View>
  <Image name="img" value="$image" zoom="true" zoomControl="true"/>
  <KeyPointLabels name="kp" toName="img"><Label value="Corner" background="#FF4D4F"/></KeyPointLabels>
  <BrushLabels name="wall_brush" toName="img"><Label value="Wall" background="#52C41A"/></BrushLabels>
  <Choices name="scope" toName="img" choice="single" required="true">
    <Choice value="In-scope: camera room only" alias="normal"/>
    <Choice value="OOS: geometric assumption invalid / non-Manhattan" alias="oos_geometry"/>
    <Choice value="OOS: open or ambiguous camera-room boundary" alias="oos_open_boundary"/>
    <Choice value="OOS: split-level or multi-level layout" alias="oos_split_level"/>
    <Choice value="OOS: insufficient geometric evidence" alias="oos_insufficient"/>
  </Choices>
  <Text name="scope_rule_text" value="未来 C2/Stage3 规则：Scope 字段是 OOS 的唯一权威信号；不得从几何或其它回答推断 OOS。"/>
  <Choices name="difficulty" toName="img" choice="multiple" required="true">
    <Choice value="Trivial / very easy" alias="trivial" hint="Choose only when no concrete difficulty applies."/>
    <Choice value="Occlusion" alias="occlusion"/><Choice value="Low texture or plain walls" alias="low_texture"/>
    <Choice value="Panorama seam or stretch distortion" alias="seam"/><Choice value="Reflection or glass interference" alias="reflection"/>
    <Choice value="Blur, mask, or low image quality" alias="low_quality"/>
  </Choices>
  <Text name="difficulty_rule_text" value="选择所有确实增加标注难度的具体因素；trivial 与所有具体困难标签互斥。"/>
  <Choices name="model_issue" toName="img" choice="multiple" required="true">
    <Choice value="模型质量可接受" alias="acceptable" hint="显式回答：acceptable 与所有具体 issue 互斥。"/>
    <Choice value="Over-extend to adjacent room" alias="overextend_adjacent"/><Choice value="Under-extend / missing room parts" alias="underextend"/>
    <Choice value="Over-parsing / ghost geometry" alias="over_parsing"/><Choice value="Corner drift" alias="corner_drift"/>
    <Choice value="Duplicate corner points" alias="corner_duplicate"/><Choice value="Topological failure" alias="topology_failure"/><Choice value="Prediction failure" alias="fail"/>
  </Choices>
  <Text name="model_issue_rule_text" value="未来 C2/Stage3 规则：acceptable 是与所有具体 issue 互斥的显式回答；不得用基于几何的推断替换它。"/>
  <HyperText name="vis_3d" value="$vis_3d" valueType="url" inline="false"/>
</View>
