<View>
  <View style="display:flex; height:100vh; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <View style="flex:60%; margin-right:12px; display:flex; flex-direction:column; height:100%;">
      <View style="flex:0 0 40%; min-height:330px; padding:8px; background:#fff;">
        <Image name="img" value="$image" zoom="true" zoomControl="true" style="height:100%; border:1px solid #eee;"/>
      </View>
      <View style="display:flex; gap:8px; padding:6px 12px; background:#fff;">
        <KeyPointLabels name="kp" toName="img" strokeWidth="2"><Label value="Corner" background="#FF4D4F"/></KeyPointLabels>
        <BrushLabels name="wall_brush" toName="img"><Label value="Wall" background="#52C41A"/></BrushLabels>
      </View>
      <View style="flex:1; overflow-y:auto; padding:12px 16px; background:#fff;">
        <Header value="A. 图像与任务判断（按培训要求，请在编辑前填写）"/>
        <Text name="scope_status_rule_text" value="第一步只判断相机所在的当前空间是否适用于既定布局标注协议。该回答是标注者判断，不是研究者真值。"/>
        <Choices name="scope_status" toName="img" choice="single" showInLine="true" required="true" requiredMessage="必须选择是否 In-scope">
          <Choice value="in_scope" alias="in_scope" html="In-scope：适用"/>
          <Choice value="out_of_scope" alias="out_of_scope" html="Out-of-scope：不适用"/>
        </Choices>

        <Text name="multiple_plausible_layouts_rule_text" value="第二步独立判断：是否存在两个或以上同样合理、都能由当前图像证据支持的标注结果。选择“否”只表示没有观察到两个以上合理结果，不等于研究者已确认唯一真值。"/>
        <Choices name="multiple_plausible_layouts" toName="img" choice="single" showInLine="true" required="true" requiredMessage="必须回答是否存在多个合理标注">
          <Choice value="no" alias="no" html="否"/>
          <Choice value="yes" alias="yes" html="是"/>
        </Choices>

        <Text name="perceived_difficulty_rule_text" value="请评价你完成本图布局标注时主观感受到的总体难度：1=很容易，5=很困难。"/>
        <Choices name="perceived_difficulty" toName="img" choice="single" showInLine="true" required="true" requiredMessage="必须选择 1–5 难度">
          <Choice value="1" alias="1"/><Choice value="2" alias="2"/><Choice value="3" alias="3"/><Choice value="4" alias="4"/><Choice value="5" alias="5"/>
        </Choices>

        <Text name="difficulty_reason_status_rule_text" value="请先说明是否观察到明确的困难原因，用于区分“确实没有明确原因”和“漏填原因”。"/>
        <Choices name="difficulty_reason_status" toName="img" choice="single" showInLine="true" required="true" requiredMessage="必须说明是否存在明确困难原因">
          <Choice value="no_specific_reason" alias="no_specific_reason" html="没有明确的困难原因"/>
          <Choice value="one_or_more_specific_reasons" alias="one_or_more_specific_reasons" html="有一个或多个明确原因"/>
        </Choices>
        <View visibleWhen="choice-selected" whenTagName="difficulty_reason_status" whenChoiceValue="one_or_more_specific_reasons">
          <Text name="difficulty_reason_rule_text" value="选择所有确实增加标注难度的原因；同一底层原因不要重复归类。"/>
          <Choices name="difficulty_reason" toName="img" choice="multiple" required="true" requiredMessage="已声明存在原因，必须至少选择一项">
            <Choice value="occlusion" alias="occlusion" html="遮挡"/>
            <Choice value="low_texture" alias="low_texture" html="低纹理或纯色墙"/>
            <Choice value="seam_or_distortion" alias="seam_or_distortion" html="全景拼接缝或几何畸变"/>
            <Choice value="reflection_or_transparency" alias="reflection_or_transparency" html="反射、玻璃或透明材质干扰"/>
            <Choice value="opening_or_adjacent_space" alias="opening_or_adjacent_space" html="开口或相邻空间干扰"/>
            <Choice value="image_quality" alias="image_quality" html="模糊、遮罩、曝光或其他画质问题"/>
            <Choice value="other" alias="other" html="其他"/>
          </Choices>
        </View>

        <Header value="B. 模型 proposal 判断（按培训要求，请在编辑前填写）"/>
        <Text name="material_issue_rule_text" value="判断初始 proposal 是否存在实质问题。该回答是标注者感知，不是 proposal truth；Correct/Wrong 条件不会显示给标注者。"/>
        <Choices name="material_issue" toName="img" choice="single" showInLine="true" required="true" requiredMessage="必须判断 proposal 是否存在实质问题">
          <Choice value="no" alias="no" html="否"/>
          <Choice value="yes" alias="yes" html="是"/>
          <Choice value="unsure" alias="unsure" html="不确定"/>
        </Choices>
        <View visibleWhen="choice-selected" whenTagName="material_issue" whenChoiceValue="yes,unsure">
          <Text name="primary_issue_family_rule_text" value="选择一个最主要的问题；如果无法判断类别，选择 unsure。"/>
          <Choices name="primary_issue_family" toName="img" choice="single" required="true" requiredMessage="必须选择一个主要问题类别">
            <Choice value="boundary_or_corner_localization" alias="boundary_or_corner_localization" html="边界或角点定位"/>
            <Choice value="underextension" alias="underextension" html="欠延伸或漏掉当前空间"/>
            <Choice value="adjacent_space_overextension" alias="adjacent_space_overextension" html="过度延伸到相邻空间"/>
            <Choice value="overparsing_or_ghost_structure" alias="overparsing_or_ghost_structure" html="过度解析或虚假结构"/>
            <Choice value="duplicate_corner" alias="duplicate_corner" html="重复角点"/>
            <Choice value="topology_order_or_closure" alias="topology_order_or_closure" html="拓扑、顺序或闭合问题"/>
            <Choice value="other" alias="other" html="其他"/>
            <Choice value="unsure" alias="unsure" html="无法判断类别"/>
          </Choices>
          <Text name="secondary_issue_families_rule_text" value="如还有其他明确的次要问题可多选；不要重复选择 primary。"/>
          <Choices name="secondary_issue_families" toName="img" choice="multiple">
            <Choice value="boundary_or_corner_localization" alias="boundary_or_corner_localization" html="边界或角点定位"/>
            <Choice value="underextension" alias="underextension" html="欠延伸或漏掉当前空间"/>
            <Choice value="adjacent_space_overextension" alias="adjacent_space_overextension" html="过度延伸到相邻空间"/>
            <Choice value="overparsing_or_ghost_structure" alias="overparsing_or_ghost_structure" html="过度解析或虚假结构"/>
            <Choice value="duplicate_corner" alias="duplicate_corner" html="重复角点"/>
            <Choice value="topology_order_or_closure" alias="topology_order_or_closure" html="拓扑、顺序或闭合问题"/>
            <Choice value="other" alias="other" html="其他"/>
          </Choices>
        </View>

        <Text name="required_correction_rule_text" value="选择你认为最合适的修正要求。该字段与 material_issue 的组合不会被系统强行解释或改写。"/>
        <Choices name="required_correction" toName="img" choice="single" required="true" requiredMessage="必须选择修正要求">
          <Choice value="no_edit_needed" alias="no_edit_needed" html="无需编辑"/>
          <Choice value="optional_visual_micro_refinement" alias="optional_visual_micro_refinement" html="可选的视觉微调"/>
          <Choice value="minor_mandatory_coordinate_correction" alias="minor_mandatory_coordinate_correction" html="必须做小幅坐标修正"/>
          <Choice value="major_geometry_correction" alias="major_geometry_correction" html="必须做较大几何修正"/>
          <Choice value="topology_change_or_redraw" alias="topology_change_or_redraw" html="需要改变拓扑或重画"/>
        </Choices>

        <Text name="issue_confidence_rule_text" value="你对上述 proposal 判断有多大信心：1=很没把握，5=很有把握。"/>
        <Choices name="issue_confidence" toName="img" choice="single" showInLine="true" required="true" requiredMessage="必须选择 1–5 信心">
          <Choice value="1" alias="1"/><Choice value="2" alias="2"/><Choice value="3" alias="3"/><Choice value="4" alias="4"/><Choice value="5" alias="5"/>
        </Choices>
      </View>
    </View>
    <View style="flex:40%; border-left:1px solid #ccc; padding-left:10px;">
      <HyperText name="vis_3d" value="$vis_3d" valueType="url" inline="false"/>
    </View>
  </View>
</View>
